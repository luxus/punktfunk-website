---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
import GuidedInstaller from "@/components/GuidedInstaller.astro";
import GuidedClient from "@/components/GuidedClient.astro";
import { links } from "@/data/site";
---

<Base
  title="Install Punktfunk — host & client guides"
  description="Short, no-nonsense guides to install the Punktfunk host on Linux or Windows and connect a client on Mac, iPhone, iPad, Apple TV, Android, Windows, Linux or the Steam Deck."
>
  {/* ------------------------------------------------------------- Intro */}
  <section class="relative overflow-hidden">
    <div class="hero-aurora pointer-events-none absolute inset-0 opacity-80"></div>
    <div class="hero-grid pointer-events-none absolute inset-0"></div>
    <div class="hero-noise pointer-events-none absolute inset-0"></div>
    <div
      class="pointer-events-none absolute inset-0"
      style="background-image: linear-gradient(to bottom, transparent 40%, var(--color-neutral) 100%);"
    >
    </div>
    <div class="container-page relative py-16 text-center sm:py-20">
      <p class="eyebrow eyebrow-center">Install</p>
      <h1 class="mx-auto mt-3 max-w-2xl text-4xl font-bold sm:text-5xl">Install <span class="text-gradient">Punktfunk</span></h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-secondary">
        Two short steps: install the <strong class="text-main">host</strong> on the
        PC you're streaming from, then add a <strong class="text-main">client</strong>
        on whatever you're streaming to.
      </p>
    </div>
  </section>

  {/* --------------------------------------------- Host + client pickers */}
  <section class="container-page scroll-mt-24 pb-8">
    <div data-reveal class="grid items-start gap-6 lg:grid-cols-2">
      <div id="host" class="scroll-mt-24">
        <GuidedInstaller />
      </div>
      <div>
        <GuidedClient />
      </div>
    </div>

    <div class="mx-auto mt-6 flex max-w-5xl items-start gap-3 rounded-xl border border-border bg-neutral-highlight/30 px-5 py-4 text-sm text-secondary">
      <Icon name="shield-check" size={18} class="mt-0.5 shrink-0 text-success" />
      <p>
        Every client discovers hosts on your network automatically. The first time,
        you pair with a one-time 4-digit PIN — after that the device is trusted. No
        account, no cloud. See{" "}
        <a href={`${links.docs}/docs/pairing`} class="text-brand-light underline underline-offset-2">pairing</a>.
      </p>
    </div>
  </section>

  {/* -------------------------------------------------------------- Help */}
  <section class="container-page py-12 pb-24">
    <div class="flex flex-col items-center gap-4 text-center">
      <p class="text-secondary">Stuck, or want the deep dive?</p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={links.quickstart} class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold text-main transition-colors hover:border-brand-light">
          <Icon name="rocket" size={16} /> Quick start
        </a>
        <a href={links.supportMatrix} class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold text-main transition-colors hover:border-brand-light">
          <Icon name="layout-grid" size={16} /> What works where
        </a>
        <a href={links.discord} class="inline-flex items-center gap-2 rounded-full border border-border px-5 py-2.5 text-sm font-semibold text-main transition-colors hover:border-brand-light">
          <Icon name="message-circle" size={16} /> Ask on Discord
        </a>
      </div>
    </div>
  </section>
</Base>
