---
import Icon from "./Icon.astro";
import { hostPlatforms, installCommands } from "@/data/installer";

// Everything the client script needs, serialized once.
const payload = {
  platforms: hostPlatforms,
  commands: installCommands,
};
---

<div
  class="rounded-[var(--radius-card)] border border-border bg-neutral-accent/60 p-6 sm:p-8"
  id="installer"
  data-installer
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-xl font-semibold text-main sm:text-2xl">
        Guided host installer
      </h3>
      <p class="mt-2 max-w-xl text-sm text-secondary">
        Pick the machine (or machines) you want to stream <em>from</em>. Select as
        many as you like — we'll show the exact commands for each.
      </p>
    </div>
    <span
      class="hidden shrink-0 rounded-full bg-brand/15 px-3 py-1 text-xs font-medium text-brand-light sm:inline-block"
      >Step 1 of 2</span
    >
  </div>

  <fieldset class="mt-6">
    <legend class="sr-only">Choose your host operating systems</legend>
    <div class="flex flex-wrap gap-2.5" role="group" aria-label="Host platforms">
      {
        hostPlatforms.map((p) => (
          <button
            type="button"
            class="installer-chip group flex items-center gap-2 rounded-full border border-border bg-neutral px-3.5 py-2 text-sm font-medium text-secondary transition-all hover:border-brand-light/60 hover:text-main aria-pressed:border-brand aria-pressed:bg-brand/15 aria-pressed:text-main"
            data-id={p.id}
            aria-pressed="false"
          >
            <img
              src={`/os-icons/${p.icon}.svg`}
              alt=""
              width="18"
              height="18"
              class="h-[18px] w-[18px] opacity-70 group-aria-pressed:opacity-100"
            />
            {p.name}
            <span class="check hidden text-brand-light group-aria-pressed:inline-flex">
              <Icon name="check" size={15} />
            </span>
          </button>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-7" data-installer-output>
    <div
      class="flex items-center gap-3 rounded-xl border border-dashed border-border px-4 py-6 text-sm text-secondary"
      data-installer-empty
    >
      <Icon name="terminal" size={18} class="text-brand-light" />
      Select one or more systems above to reveal your install commands.
    </div>
    <div class="hidden space-y-4" data-installer-results></div>
  </div>

  <p class="mt-4 flex items-center gap-2 text-xs text-secondary">
    <Icon name="shield-check" size={14} class="text-success" />
    Always review an install script before piping it to a shell. Prefer manual
    steps? Each system has a one-page guide, linked with your selection.
  </p>
</div>

<script is:inline set:html={`window.__PF_INSTALLER__ = ${JSON.stringify(payload)};`} />

<script>
  type Platform = {
    id: string;
    name: string;
    icon: string;
    family: "linux" | "windows";
    doc: string;
    note?: string;
  };
  type Payload = {
    platforms: Platform[];
    commands: { linux: string; windows: string[] };
  };

  const data = (window as unknown as { __PF_INSTALLER__: Payload })
    .__PF_INSTALLER__;
  const root = document.querySelector<HTMLElement>("[data-installer]");
  if (root && data) {
    const chips = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".installer-chip"),
    );
    const empty = root.querySelector<HTMLElement>("[data-installer-empty]")!;
    const results = root.querySelector<HTMLElement>("[data-installer-results]")!;
    const selected = new Set<string>();

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          c
        ] as string,
      );

    const commandBlock = (title: string, lines: string[], covers: string) => {
      const code = lines.map(escapeHtml).join("\n");
      const joined = lines.join("\n");
      return `
        <div class="overflow-hidden rounded-xl border border-border bg-neutral">
          <div class="flex items-center justify-between gap-3 border-b border-border px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-wide text-secondary">${escapeHtml(
              title,
            )}</span>
            <button type="button" class="copy-btn inline-flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-secondary transition-colors hover:bg-neutral-highlight hover:text-main" data-copy="${escapeHtml(
              joined,
            )}">Copy</button>
          </div>
          <pre class="overflow-x-auto px-4 py-3 text-sm leading-relaxed text-main"><code>${code}</code></pre>
          <p class="border-t border-border px-4 py-2 text-xs text-secondary">${covers}</p>
        </div>`;
    };

    const noteList = (platforms: Platform[]) => {
      const items = platforms
        .filter((p) => p.note)
        .map(
          (p) =>
            `<li class="flex gap-2"><span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-brand-light"></span><span><strong class="text-main">${escapeHtml(
              p.name,
            )}:</strong> ${escapeHtml(p.note as string)}</span></li>`,
        )
        .join("");
      return items
        ? `<ul class="space-y-1.5 text-sm text-secondary">${items}</ul>`
        : "";
    };

    const docLinks = (platforms: Platform[]) =>
      `<div class="flex flex-wrap gap-2">${platforms
        .map(
          (p) =>
            `<a href="${p.doc}" class="inline-flex items-center gap-1 rounded-full border border-border px-3 py-1 text-xs text-secondary transition-colors hover:border-brand-light hover:text-main">${escapeHtml(
              p.name,
            )} guide →</a>`,
        )
        .join("")}</div>`;

    const render = () => {
      const picked = data.platforms.filter((p) => selected.has(p.id));
      if (picked.length === 0) {
        empty.classList.remove("hidden");
        results.classList.add("hidden");
        results.innerHTML = "";
        return;
      }
      empty.classList.add("hidden");
      results.classList.remove("hidden");

      const linux = picked.filter((p) => p.family === "linux");
      const windows = picked.filter((p) => p.family === "windows");
      const blocks: string[] = [];

      if (linux.length > 0) {
        blocks.push(
          commandBlock(
            "Linux — one command",
            [data.commands.linux],
            `Covers ${linux.map((p) => p.name).join(", ")}.`,
          ),
        );
      }
      if (windows.length > 0) {
        blocks.push(
          commandBlock(
            "Windows 11 — PowerShell",
            data.commands.windows,
            "Installs the host plus the signed display and gamepad drivers.",
          ),
        );
      }

      const notes = noteList(picked);
      results.innerHTML =
        blocks.join("") +
        (notes ? `<div class="pt-1">${notes}</div>` : "") +
        `<div class="pt-1">${docLinks(picked)}</div>`;

      results.querySelectorAll<HTMLButtonElement>(".copy-btn").forEach((btn) => {
        btn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy ?? "");
            const prev = btn.textContent;
            btn.textContent = "Copied";
            setTimeout(() => (btn.textContent = prev), 1500);
          } catch {
            /* clipboard unavailable — no-op */
          }
        });
      });
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const id = chip.dataset.id!;
        const now = chip.getAttribute("aria-pressed") !== "true";
        chip.setAttribute("aria-pressed", String(now));
        if (now) selected.add(id);
        else selected.delete(id);
        render();
      });
    });
  }
</script>
