---
/**
 * The vertical-integration story as a stack cutaway: game → our driver →
 * our protocol → our client → your screen, with the punktfunk-owned layers
 * tagged. A soft pulse sweeps a frame down the stack. Decorative —
 * surrounding copy names the same layers in prose.
 */
const layers = [
  { label: "Game", ours: false },
  { label: "Display driver", ours: true },
  { label: "punktfunk/1", ours: true },
  { label: "Native client", ours: true },
  { label: "Your screen", ours: false },
];
---

<div aria-hidden="true" class="relative w-full max-w-60 overflow-hidden py-1">
  <span class="stack-pulse" data-stack-pulse></span>
  <div class="flex flex-col gap-1.5">
    {
      layers.map((l) => (
        <div class:list={[
          "flex items-center justify-between rounded-md border px-3 py-1.5 text-left font-display text-sm font-medium",
          l.ours ? "stack-ours" : "stack-theirs",
        ]}>
          <span class="min-w-0 truncate">{l.label}</span>
          {l.ours ? (
            <span class="ml-3 shrink-0 text-xs uppercase tracking-wide text-highlight">ours</span>
          ) : null}
        </div>
      ))
    }
  </div>
</div>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (reduce) {
    document.querySelector("[data-stack-pulse]")?.remove();
  }
</script>

<style>
  .stack-ours {
    border-color: color-mix(in oklch, var(--color-highlight) 40%, transparent);
    color: var(--color-main);
    background: color-mix(in oklch, var(--color-highlight) 7%, transparent);
  }
  .stack-theirs {
    border-color: color-mix(in oklch, white 25%, transparent);
    color: color-mix(in oklch, white 60%, transparent);
  }
  .stack-pulse {
    pointer-events: none;
    position: absolute;
    left: 0;
    right: 0;
    height: 2rem;
    background: color-mix(in oklch, var(--color-highlight) 12%, transparent);
    animation: stack-sweep 3.2s linear infinite;
  }
  @keyframes stack-sweep {
    from { top: -15%; }
    to { top: 110%; }
  }
</style>
