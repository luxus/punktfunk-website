---
/**
 * Distro / OS / launcher brand mark, inlined at build time through Vite
 * `?raw` imports (same mechanism as `Icon.astro`) so `fill="currentColor"`
 * inherits the surrounding text color.
 *
 * The marks are monochrome `currentColor` SVGs: loaded through `<img>` the
 * `currentColor` resolves to black with no page inheritance (black glyphs
 * on a dark surface), and reading them via `node:fs` + `process.cwd()` in
 * frontmatter turned out to depend on the builder's working directory —
 * the deployed build silently fell back to `?` placeholders. Eager glob
 * imports fail the build loudly on a missing file instead.
 */
const { name, dir = "os-icons", size = 22, class: className = "", label = "" } = Astro.props as {
  /** File stem, e.g. "ubuntu" or "steam". */
  name: string;
  /** Icon set. */
  dir?: "os-icons" | "launcher-icons";
  size?: number;
  class?: string;
  label?: string;
};

const folder = dir === "launcher-icons" ? "launchers" : "os";

const osIcons = import.meta.glob<string>("../brand-icons/os/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const launcherIcons = import.meta.glob<string>("../brand-icons/launchers/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const table = dir === "launcher-icons" ? launcherIcons : osIcons;
const raw = table[`../brand-icons/${folder}/${name}.svg`];

if (!raw) {
  throw new Error(`Brand icon "${name}" not found in src/brand-icons/${folder}`);
}

const vb = raw.match(/viewBox="([^"]+)"/);
const viewBox = vb?.[1] ?? "0 0 24 24";
const inner = raw
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<\?xml[^?]*\?>/g, "")
  .replace(/<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox={viewBox}
  width={size}
  height={size}
  fill="currentColor"
  class={`inline-block shrink-0 ${className}`}
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  set:html={inner}
/>
