---
import { readFileSync } from "node:fs";
import { join } from "node:path";

const { name, dir = "os-icons", size = 22, class: className = "", label = "" } = Astro.props as {
  name: string;
  dir?: string;
  size?: number;
  class?: string;
  label?: string;
};

const iconDir = dir === "launcher-icons" ? "launcher-icons" : "os-icons";
let inner = "";
let viewBox = "0 0 24 24";

try {
  const raw = readFileSync(join(process.cwd(), "public", iconDir, `${name}.svg`), "utf8");
  const vb = raw.match(/viewBox="([^"]+)"/);
  if (vb && vb[1]) viewBox = vb[1];
  inner = raw
    .replace(/<!--[\s\S]*?-->/g, "")
    .replace(/<\?xml[^?]*\?>/g, "")
    .replace(/<svg[^>]*>/, "")
    .replace(/<\/svg>\s*$/, "")
    .trim();
} catch (_err) {
  inner = "";
}
---

{
  inner ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox={viewBox}
      width={size}
      height={size}
      fill="currentColor"
      class={`inline-block shrink-0 ${className}`}
      role={label ? "img" : undefined}
      aria-label={label || undefined}
      aria-hidden={label ? undefined : "true"}
      set:html={inner}
    />
  ) : (
    <span
      class={`inline-flex shrink-0 items-center justify-center rounded-md bg-white/10 text-xs text-secondary ${className}`}
      style={`width:${size}px;height:${size}px`}
      aria-hidden="true"
    >
      ?
    </span>
  )
}
