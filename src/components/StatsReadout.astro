---
/**
 * A miniature of the clients' stats overlay: live-looking readouts ticking
 * through fixed values in the overlay's own vocabulary. Decorative —
 * surrounding copy describes the overlay in prose.
 */
---

<div data-stats aria-hidden="true" class="w-full rounded-lg border border-white/15 bg-black/30 px-4 py-3">
  <div class="mb-2 flex items-center gap-2">
    <span data-pulse class="stats-pulse"></span>
    <span class="font-display text-xs font-medium uppercase tracking-wide text-main/50">live</span>
  </div>
  <div class="flex flex-col gap-1">
    <div class="flex items-baseline justify-between">
      <span class="text-xs text-main/50">fps</span>
      <span data-fps class="font-display text-lg text-main tabular-nums">240</span>
    </div>
    <div class="flex items-baseline justify-between">
      <span class="text-xs text-main/50">capture → rx</span>
      <span data-ms class="font-display text-lg text-main tabular-nums">1.31 ms</span>
    </div>
    <div class="flex items-baseline justify-between">
      <span class="text-xs text-main/50">jitter</span>
      <span data-jitter class="font-display text-lg text-main tabular-nums">±0.14 ms</span>
    </div>
  </div>
</div>

<script>
  const FRAMES = [
    { fps: "240", ms: "1.31", jitter: "0.14" },
    { fps: "240", ms: "1.28", jitter: "0.15" },
    { fps: "239", ms: "1.34", jitter: "0.13" },
    { fps: "240", ms: "1.30", jitter: "0.16" },
    { fps: "241", ms: "1.27", jitter: "0.14" },
    { fps: "240", ms: "1.33", jitter: "0.12" },
  ];
  const STEP_MS = 900;

  const root = document.querySelector("[data-stats]");
  if (root) {
    const fps = root.querySelector("[data-fps]") as HTMLElement;
    const ms = root.querySelector("[data-ms]") as HTMLElement;
    const jitter = root.querySelector("[data-jitter]") as HTMLElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      root.querySelector("[data-pulse]")?.classList.remove("stats-pulse-anim");
    } else {
      let i = 0;
      window.setInterval(() => {
        i = (i + 1) % FRAMES.length;
        const f = FRAMES[i]!;
        fps.textContent = f.fps;
        ms.textContent = `${f.ms} ms`;
        jitter.textContent = `±${f.jitter} ms`;
      }, STEP_MS);
    }
  }
</script>

<style>
  .stats-pulse {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background: var(--color-highlight);
    animation: stats-blink 1.6s ease-in-out infinite;
  }
  @keyframes stats-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }
</style>
