---
import Logo from "./Logo.astro";
import Icon from "./Icon.astro";
import { links } from "@/data/site";

const nav = [
  { label: "Features", href: "/#features" },
  { label: "Why Punktfunk", href: "/#compare" },
  { label: "Install", href: "/#installer" },
  { label: "Docs", href: links.docs },
];
---

<header
  class="sticky top-0 z-50 border-b border-border bg-neutral/70 backdrop-blur-xl"
>
  <div class="container-page flex h-[var(--spacing-header)] items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5" aria-label="Punktfunk home">
      <Logo class="h-7 w-auto" />
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-secondary transition-colors hover:text-main"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={links.source}
        class="hidden rounded-full p-2 text-secondary transition-colors hover:bg-neutral-highlight hover:text-main sm:inline-flex"
        aria-label="Source code"
      >
        <Icon name="git-branch" size={20} />
      </a>
      <a
        href="/install"
        class="inline-flex items-center gap-2 rounded-full bg-brand px-4 py-2 text-sm font-semibold text-main shadow-lg shadow-brand/25 transition-transform hover:scale-[1.03] hover:bg-brand-light"
      >
        <Icon name="download" size={16} />
        Get Punktfunk
      </a>
      <button
        id="menu-toggle"
        class="rounded-full p-2 text-secondary hover:bg-neutral-highlight hover:text-main md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden border-t border-border bg-neutral/95 px-5 py-4 md:hidden"
  >
    <nav class="flex flex-col gap-1" aria-label="Mobile">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="rounded-lg px-3 py-2.5 text-base font-medium text-secondary hover:bg-neutral-highlight hover:text-main"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => menu.classList.add("hidden")),
  );
</script>
