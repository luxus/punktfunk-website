---
import Icon from "./Icon.astro";
import OsIcon from "./OsIcon.astro";
import { clientApps, mobileStores, links } from "@/data/site";

// Everything the client script needs, serialized once.
const payload = {
  clients: clientApps,
  stores: mobileStores,
  supportMatrix: links.supportMatrix,
};
---

<div
  class="rounded-[var(--radius-card)] border border-border bg-neutral-accent/60 p-6 sm:p-8"
  id="clients"
  data-client-picker
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-xl font-semibold text-main sm:text-2xl">
        Guided client picker
      </h3>
      <p class="mt-2 max-w-xl text-sm text-secondary">
        Pick the device (or devices) you want to stream <em>to</em>. Select as
        many as you like — we'll show where to get each app.
      </p>
    </div>
    <span
      class="hidden shrink-0 rounded-full bg-brand/15 px-3 py-1 text-xs font-medium text-brand-light sm:inline-block"
      >Step 2 of 2</span
    >
  </div>

  <fieldset class="mt-6">
    <legend class="sr-only">Choose your client devices</legend>
    <div class="flex flex-wrap gap-2.5" role="group" aria-label="Client devices">
      {
        clientApps.map((c) => (
          <button
            type="button"
            class="client-chip group flex items-center gap-2 rounded-full border border-border bg-neutral px-3.5 py-2 text-sm font-medium text-secondary transition-all hover:border-brand-light/60 hover:text-main aria-pressed:border-brand aria-pressed:bg-brand/15 aria-pressed:text-main"
            data-device={c.device}
            aria-pressed="false"
          >
            <OsIcon
              name={c.os}
              size={18}
              class="text-main opacity-90 transition-opacity group-aria-pressed:opacity-100"
            />
            {c.device}
            <span class="check hidden text-brand-light group-aria-pressed:inline-flex">
              <Icon name="check" size={15} />
            </span>
          </button>
        ))
      }
    </div>
  </fieldset>

  <div class="mt-7" data-client-output>
    <div
      class="flex items-center gap-3 rounded-xl border border-dashed border-border px-4 py-6 text-sm text-secondary"
      data-client-empty
    >
      <Icon name="monitor-play" size={18} class="text-brand-light" />
      Select one or more devices above to reveal their downloads.
    </div>
    <div class="hidden space-y-4" data-client-results></div>
  </div>

  <p class="mt-4 flex items-center gap-2 text-xs text-secondary">
    <Icon name="shield-check" size={14} class="text-success" />
    Every client discovers hosts on your network automatically and pairs once
    with a 4-digit PIN. No account, no cloud.
  </p>
</div>

<script is:inline set:html={`window.__PF_CLIENTS__ = ${JSON.stringify(payload)};`} />

<script>
  type Client = {
    device: string;
    os: string;
    how: string;
    store?: "android" | "apple";
  };
  type Store = {
    name: string;
    label: string;
    icon: string;
    qr: string;
    href: string;
    note: string;
  };
  type Payload = {
    clients: Client[];
    stores: Store[];
    supportMatrix: string;
  };

  const data = (window as unknown as { __PF_CLIENTS__: Payload }).__PF_CLIENTS__;
  const root = document.querySelector<HTMLElement>("[data-client-picker]");
  if (root && data) {
    const chips = Array.from(
      root.querySelectorAll<HTMLButtonElement>(".client-chip"),
    );
    const empty = root.querySelector<HTMLElement>("[data-client-empty]")!;
    const results = root.querySelector<HTMLElement>("[data-client-results]")!;
    const selected = new Set<string>();

    const escapeHtml = (s: string) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[
          c
        ] as string,
      );

    const storeCard = (c: Client) => {
      const store = data.stores.find(
        (s) => s.name.toLowerCase() === c.store,
      );
      if (!store) return "";
      return `
        <div class="mt-4 flex flex-col items-center gap-4 rounded-xl border border-border bg-neutral px-4 py-5 sm:flex-row sm:gap-5">
          <div class="rounded-xl bg-white p-2.5 shadow-lg shadow-black/20">
            <img src="${store.qr}" alt="QR code to install the ${escapeHtml(
              store.name,
            )} app" width="120" height="120" class="h-[120px] w-[120px]" loading="lazy" />
          </div>
          <div class="text-center sm:text-left">
            <p class="text-sm font-semibold text-main">${escapeHtml(store.label)}</p>
            <p class="mt-0.5 text-xs text-secondary">${escapeHtml(store.note)}</p>
            <a href="${
              store.href
            }" class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-brand px-4 py-2 text-xs font-semibold text-main transition-transform hover:scale-[1.03] hover:bg-brand-light">Get the app →</a>
          </div>
        </div>`;
    };

    const render = () => {
      const picked = data.clients.filter((c) => selected.has(c.device));
      if (picked.length === 0) {
        empty.classList.remove("hidden");
        results.classList.add("hidden");
        results.innerHTML = "";
        return;
      }
      empty.classList.add("hidden");
      results.classList.remove("hidden");

      results.innerHTML = picked
        .map(
          (c) => `
        <div class="overflow-hidden rounded-xl border border-border bg-neutral">
          <div class="border-b border-border px-4 py-2.5">
            <span class="text-xs font-semibold uppercase tracking-wide text-secondary">${escapeHtml(
              c.device,
            )}</span>
          </div>
          <p class="px-4 pt-3 text-sm leading-relaxed text-main">${escapeHtml(c.how)}</p>
          ${
            c.store
              ? storeCard(c)
              : `<p class="px-4 py-3 text-xs text-secondary">Downloads live in the <a href="${data.supportMatrix}" class="text-brand-light underline underline-offset-2 hover:text-main">what works where</a> guide.</p>`
          }
        </div>`,
        )
        .join("");
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const device = chip.dataset.device!;
        const now = chip.getAttribute("aria-pressed") !== "true";
        chip.setAttribute("aria-pressed", String(now));
        if (now) selected.add(device);
        else selected.delete(device);
        render();
      });
    });
  }
</script>
