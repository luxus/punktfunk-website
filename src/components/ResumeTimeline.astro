---
import Icon from "./Icon.astro";

/**
 * The keep-alive story as a four-beat timeline: streaming → drop → the
 * display (and game) is kept alive → reconnect lands right back in. Dashed
 * segments mark the kept window. Decorative — surrounding copy tells the
 * same story in prose.
 */
---

<div data-resume aria-hidden="true" class="flex w-full max-w-xs flex-col items-center gap-4">
  <div class="flex w-full items-center">
    <span data-dot="0" class="resume-dot resume-active"><Icon name="monitor-play" size={14} /></span>
    <span class="h-px flex-1 bg-white/30"></span>
    <span data-dot="1" class="resume-dot"><Icon name="x" size={14} /></span>
    <span class="h-px flex-1 border-t border-dashed border-white/40"></span>
    <span data-dot="2" class="resume-dot"><Icon name="refresh-cw" size={14} /></span>
    <span class="h-px flex-1 border-t border-dashed border-white/40"></span>
    <span data-dot="3" class="resume-dot"><Icon name="zap" size={14} /></span>
  </div>
  <div class="h-5 text-center">
    <p data-caption class="font-display text-sm font-medium text-main/70">Streaming</p>
  </div>
</div>

<script>
  const CAPTIONS = ["Streaming", "Connection drops", "Display kept alive", "Right back in"];
  const STEP_MS = 1800;

  const root = document.querySelector("[data-resume]");
  if (root) {
    const dots = Array.from(root.querySelectorAll("[data-dot]"));
    const caption = root.querySelector("[data-caption]") as HTMLElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const paint = (active: number) => {
      dots.forEach((d, i) => {
        d.classList.toggle("resume-active", i === active);
        d.classList.toggle("resume-past", i < active);
      });
      caption.textContent = CAPTIONS[active] ?? "";
    };
    if (reduce) {
      paint(CAPTIONS.length - 1);
    } else {
      let phase = 0;
      paint(0);
      window.setInterval(() => {
        phase = (phase + 1) % CAPTIONS.length;
        paint(phase);
      }, STEP_MS);
    }
  }
</script>

<style>
  .resume-dot {
    display: flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid color-mix(in oklch, white 25%, transparent);
    color: color-mix(in oklch, white 30%, transparent);
    transition: border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }
  .resume-past {
    border-color: color-mix(in oklch, white 40%, transparent);
    color: color-mix(in oklch, white 60%, transparent);
  }
  .resume-active {
    border-color: var(--color-highlight);
    color: var(--color-highlight);
    box-shadow: 0 0 18px -4px var(--color-highlight);
  }
</style>
