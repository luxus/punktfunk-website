---
/**
 * Inline SVG icon. Icons are the Lucide static set (ISC) copied into
 * src/icons, loaded at build time so nothing ships at runtime.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  "stroke-width"?: number;
}

const { name, size = 24, class: className = "", "stroke-width": strokeWidth } = Astro.props;

const icons = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const raw = icons[`../icons/${name}.svg`];

if (!raw) {
  throw new Error(`Icon "${name}" not found in src/icons`);
}

// Strip the license comment and the outer <svg …> attributes, keeping the
// inner shapes, so we can re-wrap with our own sizing and classes.
const inner = raw
  .replace(/<!--[\s\S]*?-->/g, "")
  .replace(/<svg[^>]*>/, "")
  .replace(/<\/svg>\s*$/, "")
  .trim();
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth ?? 2}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`inline-block shrink-0 ${className}`}
  aria-hidden="true"
  set:html={inner}
/>
